<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  is_saml_account = account_user&.account&.saml_enabled?
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = 'Bem-vindo'
  heading = 'Confirme seu e-mail para começar'
  intro_text =
    "Bem-vindo ao #{brand_name}. Só precisamos verificar seu endereço de e-mail antes de começar a usar sua conta."
  supporting_text = 'Isso leva apenas um momento.'
  action_text = 'Confirmar minha conta'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Novo e-mail', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Atualização por e-mail'
    heading = 'Confirme seu novo endereço de e-mail'
    intro_text = "Recebemos uma solicitação para atualizar o endereço de e-mail da sua conta #{brand_name}."
    supporting_text = 'Confirme o novo endereço abaixo para finalizar a alteração.'
    action_text = 'Confirmar endereço de e-mail'
  elsif @resource.confirmed?
    eyebrow = 'Conta pronta'

    if is_saml_account
      heading = 'Seu acesso está pronto'
      intro_text = "Seu acesso #{brand_name} já está configurado."
      supporting_text = "Use your organization's Single Sign-On (SSO) portal to access #{brand_name}."
      action_text = nil
      action_url = nil
      info_title = "Sign in with your organization's SSO"
      info_text =
        "Você não precisará de uma senha separada para o #{brand_name}. Comece pelo portal do provedor de identidade da sua empresa."
      detail_rows = []
      detail_rows << ['Workspace', account_name] if account_name.present?
      detail_rows << ['Método de login', 'Logon único (SSO)']
    else
      heading = 'Sua conta está pronta'
      intro_text = "Sua conta #{brand_name} já está ativa."
      supporting_text = 'Use o botão abaixo para fazer login e continuar de onde parou.'
      action_text = 'Abrir minha conta'
      action_url = frontend_url('auth/sign_in')
      detail_rows = []
    end
  elsif invited_user
    eyebrow = 'Convite para workspace'
    heading = account_name.present? ? "Você foi convidado para participar de #{account_name}" : "Você foi convidado para conhecer o #{brand_name}"

    if is_saml_account
      intro_text = if account_name.present?
        "#{inviter.name} convidou você para acessar o workspace #{account_name} em #{brand_name}."
      else
        "#{inviter.name} convidou você para acessar #{brand_name}."
      end
      supporting_text =
        "Sua organização usa login único (SSO), portanto você não precisará criar uma senha separada."
      action_text = nil
      action_url = nil
      info_title = "Use your organization's SSO portal"
      info_text = "Continue no portal do provedor de identidade da sua empresa para acessar #{brand_name}."
      detail_rows = [['Convidado por', inviter.name]]
      detail_rows << ['Workspace', account_name] if account_name.present?
      detail_rows << ['Método de login', 'Logon único (SSO)']
    else
      intro_text = if account_name.present?
        "#{inviter.name} convidou você para ingressar no workspace #{account_name} em #{brand_name}."
      else
        "#{inviter.name} convidou você para experimentar #{brand_name}."
      end
      supporting_text = 'Crie sua conta para começar a colaborar com sua equipe.'
      action_text = 'Aceitar convite'
      action_url = frontend_url(
        'auth/password/edit',
        reset_password_token: @resource.send(:set_reset_password_token)
      )
      detail_rows = [['Convidado por', inviter.name]]
      detail_rows << ['Workspace', account_name] if account_name.present?
    end
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
